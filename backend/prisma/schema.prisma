generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  mobile             String?
  passwordHash       String
  role               Role                 @default(CANDIDATE)
  emailVerified      Boolean              @default(false)
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  profile            CandidateProfile?
  employerProfile    EmployerProfile?
  applications       Application[]
  jobs               Job[]
  savedJobs          SavedJob[]
  jobReports         JobReport[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  notifications      Notification[]
  supportRequests    EmployerSupportRequest[]

  @@index([role])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum Role {
  CANDIDATE
  ADMIN
  EMPLOYER
}

model CandidateProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id])
  // Display name (editable by user; separate from registered name on User.name)
  displayName        String?
  // Personal
  location           String?
  gender             String?
  nationality        String?
  dateOfBirth        String?
  maritalStatus      String?
  drivingLicense     String?
  languagesKnown     String?
  visaStatus         String?
  religion           String?
  alternateEmail     String?
  alternateMobile    String?
  // Professional
  designation        String?
  experience         String?
  industry           String?
  functionalArea     String?
  currentSalary      String?
  cvHeadline         String?
  skills             String?
  itSkills           String?
  education          String?
  summary            String?
  // Online profiles
  linkedInUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  // Desired job
  desiredJobTitle    String?
  desiredLocation    String?
  availabilityToJoin String?
  // Files
  resumePath         String?
  resumeFilename     String?
  resumeUploadedAt   DateTime?
  profilePhotoPath   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employmentEntries EmploymentEntry[]
  educationEntries  EducationEntry[]
  certifications    Certification[]

  @@index([location])
  @@index([experience])
}

model EmploymentEntry {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobTitle           String
  companyName        String
  startMonth         Int?
  startYear          Int
  endMonth           Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model EducationEntry {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  degree             String
  institution        String
  fieldOfStudy       String?
  startYear          Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model Certification {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  issuingOrg         String?
  issueYear          Int?
  credentialUrl      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model Job {
  id                  Int           @id @default(autoincrement())
  title               String
  companyName         String
  location            String
  industry            String
  employmentType      String
  experienceRequired  String
  salaryRange         String?
  description         String
  requiredSkills      String
  hrEmail             String
  gender              String?       @default("Any")
  nationality         String?       @default("Any Nationality")
  applicationDeadline DateTime?
  status              JobStatus     @default(ACTIVE)
  isDeleted           Boolean       @default(false)
  department          String?
  workMode            String?
  applyMethod         ApplyMethod   @default(PLATFORM)
  applyContact        String?
  screeningQuestion   String?
  listingDurationDays Int           @default(30)
  expiresAt           DateTime?
  creditSource        String?
  featured            Boolean       @default(false)
  flagReasons         String[]      @default([])
  reviewNote          String?
  revisesJobId        Int?
  revisesJob          Job?          @relation("JobRevisions", fields: [revisesJobId], references: [id])
  revisions           Job[]         @relation("JobRevisions")
  createdBy           Int
  creator             User          @relation(fields: [createdBy], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
  savedBy             SavedJob[]
  reports             JobReport[]

  @@index([status, isDeleted])
  @@index([location])
  @@index([industry])
  @@index([employmentType])
  @@index([experienceRequired])
  @@index([applicationDeadline])
  @@index([createdAt])
  @@index([revisesJobId])
}

enum JobStatus {
  ACTIVE
  INACTIVE
  DRAFT
  EXPIRED
  PENDING_REVIEW
  REVISION_PENDING_APPROVAL
  REJECTED
}

enum ApplyMethod {
  PLATFORM
  EXTERNAL_URL
  EMAIL
}

model JobReport {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  note      String?
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([userId])
}

model Application {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  jobId         Int
  job           Job               @relation(fields: [jobId], references: [id])
  status        ApplicationStatus @default(APPLIED)
  hrEmailStatus EmailStatus       @default(PENDING)
  hrEmailError  String?
  hrEmailSentAt DateTime?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([status])
  @@index([hrEmailStatus])
  @@index([appliedAt])
  @@index([jobId])
  @@index([userId])
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  ON_HOLD
  SELECTED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmployerProfile {
  id                    Int                @id @default(autoincrement())
  userId                Int                @unique
  user                  User               @relation(fields: [userId], references: [id])
  companyName           String
  industry              String?
  location              String?
  website               String?
  linkedinUrl           String?
  phone                 String?
  description           String?
  logoPath              String?
  companySize           String?
  contactDesignation    String?
  verificationStatus    VerificationStatus @default(PENDING)
  verificationNote      String?
  verificationSubmittedAt DateTime?
  verifiedAt            DateTime?
  taxRegistrationNumber String?
  billingAddressLine1   String?
  billingAddressLine2   String?
  billingCity           String?
  billingState          String?
  billingPostalCode     String?
  billingCountry        String?            @default("SA")
  billingEmail          String?
  isSuspended           Boolean            @default(false)
  suspendedReason       String?
  suspendedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  subscription          EmployerSubscription?
  invoices               Invoice[]
  transactions          Transaction[]
  paymentMethod         EmployerPaymentMethod?
  resumeUnlocks         ResumeUnlockEvent[]
  verificationDocuments EmployerVerificationDocument[]
  supportRequests       EmployerSupportRequest[]

  @@index([companyName])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// The five document types accepted for company verification. Each upload is
// tagged with one of these so an employer can submit several documents
// (registration, tax, ID, etc.) as one review package, matching how a real
// KYB check needs more than a single file.
enum VerificationDocumentType {
  REGISTRATION_CERTIFICATE
  TAX_REGISTRATION
  AUTHORIZED_PERSON_ID
  ADDRESS_PROOF
  AUTHORIZATION_LETTER
}

model EmployerVerificationDocument {
  id                Int                      @id @default(autoincrement())
  employerProfileId Int
  employerProfile   EmployerProfile          @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  documentType      VerificationDocumentType
  filePath          String
  fileName          String
  fileSize          Int
  createdAt         DateTime                 @default(now())

  @@index([employerProfileId])
}

enum SupportRequestCategory {
  VERIFICATION
  PROFILE
  DOCUMENTS
  ACCOUNT
  OTHER
}

model EmployerSupportRequest {
  id                Int                     @id @default(autoincrement())
  employerProfileId Int
  employerProfile   EmployerProfile         @relation(fields: [employerProfileId], references: [id])
  userId            Int
  user              User                    @relation(fields: [userId], references: [id])
  category          SupportRequestCategory
  subject           String
  message           String
  createdAt         DateTime                @default(now())

  @@index([employerProfileId])
  @@index([userId])
}

model EmployerSubscription {
  id                    Int             @id @default(autoincrement())
  employerProfileId     Int             @unique
  employerProfile       EmployerProfile @relation(fields: [employerProfileId], references: [id])
  planTier              PlanTier        @default(FREE)
  paidCreditsRemaining  Int             @default(0)
  freeJobUsedAt         DateTime?
  currentPeriodStart    DateTime?
  renewsAt              DateTime?
  cancelAtPeriodEnd     Boolean         @default(false)
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Plan {
  id                 Int      @id @default(autoincrement())
  tier               PlanTier @unique
  name               String
  priceSar           Int
  paidCreditsGranted Int
  features           String[]
  dodoProductId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Invoice {
  id                Int             @id @default(autoincrement())
  employerProfileId Int
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id])
  type              InvoiceType
  amountSar         Int
  status            InvoiceStatus   @default(PENDING)
  gatewayRef        String?
  note              String?
  issuedAt          DateTime        @default(now())
  paidAt            DateTime?
  transactions      Transaction[]
  refundsInvoiceId  Int?
  refundsInvoice    Invoice?        @relation("InvoiceRefund", fields: [refundsInvoiceId], references: [id])
  refundedBy        Invoice[]       @relation("InvoiceRefund")

  @@index([employerProfileId])
  @@index([status])
}

enum InvoiceType {
  SUBSCRIPTION
  CREDIT_PACK
  REFUND
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUND_REQUESTED
  REFUNDED
}

model EmployerPaymentMethod {
  id                     Int             @id @default(autoincrement())
  employerProfileId      Int             @unique
  employerProfile        EmployerProfile @relation(fields: [employerProfileId], references: [id])
  gatewayPaymentMethodId String
  cardBrand              String?
  cardLast4              String?
  expiryMonth            Int?
  expiryYear             Int?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Transaction {
  id                Int             @id @default(autoincrement())
  employerProfileId Int
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id])
  invoiceId         Int?
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  type              TransactionType
  amountSar         Int
  status            String
  gatewayRef        String?
  createdAt         DateTime        @default(now())

  @@index([employerProfileId])
  @@index([createdAt])
}

enum TransactionType {
  CHARGE
  REFUND
  FAILED_CHARGE
}

model DodoWebhookEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())
}

model ResumeUnlockEvent {
  id                Int             @id @default(autoincrement())
  employerProfileId Int
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id])
  applicationId     Int
  createdAt         DateTime        @default(now())

  @@unique([employerProfileId, applicationId])
  @@index([employerProfileId, createdAt])
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SavedJob {
  id      Int      @id @default(autoincrement())
  userId  Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId   Int
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model ScrapedJob {
  id                 Int              @id @default(autoincrement())
  title              String
  companyName        String
  location           String?
  source             String
  applyUrl           String
  status             ScrapedJobStatus @default(LIVE)
  isDuplicateSuspect Boolean          @default(false)
  lastCheckedAt      DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([companyName])
}

enum ScrapedJobStatus {
  LIVE
  BROKEN
  HIDDEN
}
