generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  mobile             String?
  passwordHash       String
  role               Role                 @default(CANDIDATE)
  emailVerified      Boolean              @default(false)
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  profile            CandidateProfile?
  employerProfile    EmployerProfile?
  applications       Application[]
  jobs               Job[]
  savedJobs          SavedJob[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]

  @@index([role])
  @@index([createdAt])
}

enum Role {
  CANDIDATE
  ADMIN
  EMPLOYER
}

model CandidateProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  user               User      @relation(fields: [userId], references: [id])
  // Display name (editable by user; separate from registered name on User.name)
  displayName        String?
  // Personal
  location           String?
  gender             String?
  nationality        String?
  dateOfBirth        String?
  maritalStatus      String?
  drivingLicense     String?
  languagesKnown     String?
  visaStatus         String?
  religion           String?
  alternateEmail     String?
  alternateMobile    String?
  // Professional
  designation        String?
  experience         String?
  industry           String?
  functionalArea     String?
  currentSalary      String?
  cvHeadline         String?
  skills             String?
  itSkills           String?
  education          String?
  summary            String?
  // Online profiles
  linkedInUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  // Desired job
  desiredJobTitle    String?
  desiredLocation    String?
  availabilityToJoin String?
  // Files
  resumePath         String?
  resumeFilename     String?
  resumeUploadedAt   DateTime?
  profilePhotoPath   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employmentEntries  EmploymentEntry[]
  educationEntries   EducationEntry[]
  certifications     Certification[]

  @@index([location])
  @@index([experience])
}

model EmploymentEntry {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobTitle           String
  companyName        String
  startMonth         Int?
  startYear          Int
  endMonth           Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model EducationEntry {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  degree             String
  institution        String
  fieldOfStudy       String?
  startYear          Int?
  endYear            Int?
  isCurrent          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model Certification {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  profile            CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  issuingOrg         String?
  issueYear          Int?
  credentialUrl      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
}

model Job {
  id                  Int           @id @default(autoincrement())
  title               String
  companyName         String
  location            String
  industry            String
  employmentType      String
  experienceRequired  String
  salaryRange         String?
  description         String
  requiredSkills      String
  hrEmail             String
  gender              String?       @default("Any")
  nationality         String?       @default("Any Nationality")
  applicationDeadline DateTime?
  status              JobStatus     @default(ACTIVE)
  isDeleted           Boolean       @default(false)
  createdBy           Int
  creator             User          @relation(fields: [createdBy], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
  savedBy             SavedJob[]

  @@index([status, isDeleted])
  @@index([location])
  @@index([industry])
  @@index([employmentType])
  @@index([experienceRequired])
  @@index([applicationDeadline])
  @@index([createdAt])
}

enum JobStatus {
  ACTIVE
  INACTIVE
}

model Application {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  jobId         Int
  job           Job               @relation(fields: [jobId], references: [id])
  status        ApplicationStatus @default(APPLIED)
  hrEmailStatus EmailStatus       @default(PENDING)
  hrEmailError  String?
  hrEmailSentAt DateTime?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([status])
  @@index([hrEmailStatus])
  @@index([appliedAt])
  @@index([jobId])
  @@index([userId])
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  ON_HOLD
  SELECTED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmployerProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id])
  companyName        String
  industry           String?
  location           String?
  website            String?
  phone              String?
  description        String?
  logoPath           String?
  companySize        String?
  contactDesignation String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyName])
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SavedJob {
  id      Int      @id @default(autoincrement())
  userId  Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId   Int
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

