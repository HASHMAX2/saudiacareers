DATABASE_URL=postgresql://postgres.SUPABASE_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.SUPABASE_REF.supabase.co:5432/postgres
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=SaudiaCareers
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@saudiacareers.com
FRONTEND_URL=http://localhost:5173
# Exact, comma-separated origins only — no wildcard/regex matching is done
# server-side (SA-01). In production this must list every real deployed
# frontend origin explicitly, e.g.:
# https://saudiacareers.com,https://www.saudiacareers.com,https://saudiacareers-frontend.vercel.app,https://saudiacareers-employer.vercel.app,https://saudiacareers-admin.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
PORT=5000
NODE_ENV=development
